@using Copilot.Controllers
@{
    ViewData["Title"] = "ERP Console";
    
    // Retrieve lists from ViewBag
    var invoices = ViewBag.Invoices as List<Copilot.Models.Invoice> ?? new List<Copilot.Models.Invoice>();
    var inventory = ViewBag.Inventory as List<Copilot.Models.InventoryItem> ?? new List<Copilot.Models.InventoryItem>();
    var purchaseOrders = ViewBag.PurchaseOrders as List<Copilot.Models.PurchaseOrder> ?? new List<Copilot.Models.PurchaseOrder>();
    var auditLogs = ViewBag.AuditLogs as List<Copilot.Models.AuditLog> ?? new List<Copilot.Models.AuditLog>();
    var usersList = ViewBag.UsersList as List<UserDto> ?? new List<UserDto>();
    var shopifyOrders = ViewBag.ShopifyOrders as List<Copilot.Models.ShopifyOrder> ?? new List<Copilot.Models.ShopifyOrder>();
    
    // KPIs
    var totalRevenue = ViewBag.TotalRevenue != null ? (decimal)ViewBag.TotalRevenue : 0m;
    var pendingRevenue = ViewBag.PendingRevenue != null ? (decimal)ViewBag.PendingRevenue : 0m;
    var activeOrdersCount = ViewBag.ActiveOrdersCount != null ? (int)ViewBag.ActiveOrdersCount : 0;
    var expenseRatio = ViewBag.ExpenseRatio != null ? (decimal)ViewBag.ExpenseRatio : 0m;
    var availableInventoryCount = ViewBag.AvailableInventoryCount != null ? (int)ViewBag.AvailableInventoryCount : 0;

    // Shopify Specific KPIs
    var shopifyTotalSales = ViewBag.ShopifyTotalSales != null ? (decimal)ViewBag.ShopifyTotalSales : 0m;
    var shopifyOrderCount = ViewBag.ShopifyOrderCount != null ? (int)ViewBag.ShopifyOrderCount : 0;
    var shopifyUnfulfilledCount = ViewBag.ShopifyUnfulfilledCount != null ? (int)ViewBag.ShopifyUnfulfilledCount : 0;
}

<div class="dashboard-wrapper">
    <!-- Glow Blob Background Decorations -->
    <div class="glow-blob blob-1"></div>
    <div class="glow-blob blob-2"></div>
    
    <!-- Mobile Navigation Topbar -->
    <div class="mobile-header d-lg-none">
        <button class="menu-toggle-btn" id="menuToggle" type="button">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        </button>
        <div class="mobile-logo">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="me-2" style="color: #4f46e5;"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
            <span>Copilot ERP</span>
        </div>
        <div class="mobile-profile-avatar" onclick="document.querySelector('.erp-sidebar').classList.add('active')">
            @(!string.IsNullOrEmpty(ViewBag.Username) ? ViewBag.Username[0].ToString().ToUpper() : "U")
        </div>
    </div>

    <!-- Toast Container for Notifications -->
    <div class="toast-container" id="toastContainer"></div>

    <div class="erp-layout">
        <!-- Sidebar Navigation -->
        <aside class="erp-sidebar">
            <!-- Sidebar Close Header (Mobile only) -->
            <div class="d-flex justify-content-between align-items-center mb-3 d-lg-none border-bottom pb-2">
                <span class="fw-bold text-muted" style="font-size: 0.8rem;">NAVIGATION MENU</span>
                <button type="button" class="btn-close-sidebar" onclick="document.querySelector('.erp-sidebar').classList.remove('active')" style="background: none; border: none; font-size: 1.6rem; line-height: 1; color: var(--text-muted); padding: 0.2rem 0.5rem; cursor: pointer;">&times;</button>
            </div>
            
            <div class="erp-sidebar-header">
                <div class="erp-sidebar-logo">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="me-2" style="color: #4f46e5;"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
                    <span>Copilot ERP</span>
                </div>
                <div class="erp-sidebar-desc">Management Console</div>
            </div>

            <!-- User Info Card -->
            <div class="d-flex align-items-center p-3 rounded-4 bg-light border border-1" style="gap: 0.75rem;">
                <div class="rounded-circle d-flex align-items-center justify-content-center bg-primary text-white" style="width: 42px; height: 42px; font-weight: 700; font-size: 1.1rem; background: var(--primary-gradient) !important;">
                    @(!string.IsNullOrEmpty(ViewBag.Username) ? ViewBag.Username[0].ToString().ToUpper() : "U")
                </div>
                <div class="d-flex flex-column overflow-hidden" style="line-height: 1.2;">
                    <span class="fw-bold text-dark text-truncate" style="font-size: 0.95rem;">@ViewBag.Username</span>
                    <span class="text-muted text-truncate" style="font-size: 0.78rem;">@ViewBag.Email</span>
                </div>
            </div>

            <!-- Tab Buttons -->
            <div class="erp-nav-list">
                <button class="erp-nav-btn active" data-target="overview">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="9"/><rect x="14" y="3" width="7" height="5"/><rect x="14" y="12" width="7" height="9"/><rect x="3" y="16" width="7" height="5"/></svg>
                    <span>Overview</span>
                </button>
                <button class="erp-nav-btn" data-target="invoices">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M12 4v16M2 8h20M2 16h20"/></svg>
                    <span>Sales & Invoices</span>
                </button>
                <button class="erp-nav-btn" data-target="inventory">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
                    <span>Inventory Catalog</span>
                </button>
                <button class="erp-nav-btn" data-target="purchaseorders">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
                    <span>Purchase Orders</span>
                </button>
                <button class="erp-nav-btn" data-target="shopify">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg>
                    <span>Shopify Orders</span>
                </button>
                <button class="erp-nav-btn" data-target="auditlogs">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><path d="M16 13H8M16 17H8M10 9H8"/></svg>
                    <span>System Audit Logs</span>
                </button>
            </div>

            <!-- Footer Meta Info -->
            <div class="mt-auto pt-3 border-top border-1" style="font-size: 0.8rem; display: flex; flex-direction: column; gap: 0.75rem;">
                <div class="d-flex align-items-center justify-content-between">
                    <span class="text-muted">Session Security:</span>
                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1" style="font-size: 0.72rem; font-weight: 600;">@ViewBag.AuthMethod</span>
                </div>
                <form asp-controller="Auth" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="w-100 btn btn-outline-danger border border-1 py-2 rounded-3 d-flex align-items-center justify-content-center" style="gap: 0.5rem; font-weight: 600; font-size: 0.85rem;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/></svg>
                        <span>Sign Out Session</span>
                    </button>
                </form>
            </div>
        </aside>

        <!-- Main Content Area -->
        <main class="erp-content">
            
            <!-- Tab: OVERVIEW -->
            <section class="erp-tab-content active" id="overview">
                <!-- Title Header -->
                <div class="erp-module-header">
                    <div class="erp-module-title">
                        <h2>Enterprise Overview</h2>
                        <p>Real-time operating indicators, assets metrics, and financial reporting.</p>
                    </div>
                </div>

                <!-- KPI Grid -->
                <div class="stats-widget-grid">
                    <div class="stat-card">
                        <div class="stat-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                        </div>
                        <div class="stat-data">
                            <span class="stat-num">$@totalRevenue.ToString("N2")</span>
                            <span class="stat-title">Total Revenue (Paid)</span>
                        </div>
                    </div>
                    
                    <div class="stat-card">
                        <div class="stat-icon" style="color: var(--warning-color); border-color: rgba(245, 158, 11, 0.25); background: linear-gradient(135deg, rgba(245, 158, 11, 0.08) 0%, rgba(217, 119, 6, 0.08) 100%) !important;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                        </div>
                        <div class="stat-data">
                            <span class="stat-num">$@pendingRevenue.ToString("N2")</span>
                            <span class="stat-title">Pending Account Receivables</span>
                        </div>
                    </div>

                    <div class="stat-card">
                        <div class="stat-icon" style="color: #3b82f6; border-color: rgba(59, 130, 246, 0.25); background: linear-gradient(135deg, rgba(59, 130, 246, 0.08) 0%, rgba(37, 99, 235, 0.08) 100%) !important;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
                        </div>
                        <div class="stat-data">
                            <span class="stat-num">@availableInventoryCount units</span>
                            <span class="stat-title">Stock Items Available</span>
                        </div>
                    </div>

                    <div class="stat-card">
                        <div class="stat-icon" style="color: #bd93f9; border-color: rgba(189, 147, 249, 0.25); background: linear-gradient(135deg, rgba(189, 147, 249, 0.08) 0%, rgba(139, 92, 246, 0.08) 100%) !important;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
                        </div>
                        <div class="stat-data">
                            <span class="stat-num">@activeOrdersCount orders</span>
                            <span class="stat-title">Active Purchase Orders</span>
                        </div>
                    </div>

                    <div class="stat-card">
                        <div class="stat-icon" style="color: #06b6d4; border-color: rgba(6, 182, 212, 0.25); background: linear-gradient(135deg, rgba(6, 182, 212, 0.08) 0%, rgba(8, 145, 178, 0.08) 100%) !important;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21.21 15.89A10 10 0 1 1 8 2.83"/><path d="M22 12A10 10 0 0 0 12 2v10z"/></svg>
                        </div>
                        <div class="stat-data">
                            <span class="stat-num">@expenseRatio%</span>
                            <span class="stat-title">Expense-to-Revenue Ratio</span>
                        </div>
                    </div>
                </div>

                <!-- Charts Section -->
                <div class="dashboard-charts-grid">
                    <!-- Line Chart Card -->
                    <div class="db-table-card chart-card-custom d-flex flex-column justify-content-between p-4" style="min-height: 320px;">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h4 class="m-0 fw-bold text-dark" style="font-size: 1.1rem;">Cash Flow Trend (Receivables vs Paid)</h4>
                            <span class="badge bg-light text-dark border border-1 py-1 px-2" style="font-size: 0.72rem;">Last 30 Days</span>
                        </div>
                        <div class="chart-container-visual flex-grow-1 d-flex align-items-center justify-content-center">
                            <!-- Premium SVG Chart -->
                            <svg class="svg-chart-graph" viewBox="0 0 500 200" style="max-height: 180px; width: 100%;">
                                <defs>
                                    <linearGradient id="gradient-line-paid" x1="0" y1="0" x2="0" y2="1">
                                        <stop offset="0%" stop-color="#4f46e5" stop-opacity="0.15"/>
                                        <stop offset="100%" stop-color="#4f46e5" stop-opacity="0.0"/>
                                    </linearGradient>
                                </defs>
                                <!-- Grid Lines -->
                                <line x1="40" y1="20" x2="480" y2="20" stroke="#f1f5f9" stroke-width="1.5" />
                                <line x1="40" y1="70" x2="480" y2="70" stroke="#f1f5f9" stroke-width="1.5" />
                                <line x1="40" y1="120" x2="480" y2="120" stroke="#f1f5f9" stroke-width="1.5" />
                                <line x1="40" y1="170" x2="480" y2="170" stroke="#cbd5e1" stroke-width="1.5" />

                                <!-- Shadow Area Under Curve -->
                                <path d="M 40 170 L 40 130 L 120 110 L 200 145 L 280 80 L 360 95 L 440 45 L 480 65 L 480 170 Z" fill="url(#gradient-line-paid)" />

                                <!-- Paid Line Path -->
                                <path d="M 40 130 Q 80 110 120 110 T 200 145 T 280 80 T 360 95 T 440 45 T 480 65" fill="none" stroke="#4f46e5" stroke-width="3.5" stroke-linecap="round" />

                                <!-- Data Nodes -->
                                <circle cx="120" cy="110" r="5" fill="#4f46e5" stroke="#ffffff" stroke-width="2"/>
                                <circle cx="280" cy="80" r="5" fill="#4f46e5" stroke="#ffffff" stroke-width="2"/>
                                <circle cx="440" cy="45" r="5" fill="#4f46e5" stroke="#ffffff" stroke-width="2"/>

                                <!-- Text Labels -->
                                <text x="40" y="185" class="chart-txt">Week 1</text>
                                <text x="180" y="185" class="chart-txt">Week 2</text>
                                <text x="320" y="185" class="chart-txt">Week 3</text>
                                <text x="450" y="185" class="chart-txt">Week 4</text>

                                <text x="15" y="25" class="chart-txt">$25K</text>
                                <text x="15" y="75" class="chart-txt">$15K</text>
                                <text x="15" y="125" class="chart-txt">$5K</text>
                            </svg>
                        </div>
                    </div>

                    <!-- Column Progress Chart Card -->
                    <div class="db-table-card p-4 d-flex flex-column justify-content-between" style="min-height: 320px;">
                        <div>
                            <h4 class="m-0 fw-bold text-dark mb-2" style="font-size: 1.1rem;">Asset Allocation & Capacity</h4>
                            <p class="text-muted m-0" style="font-size: 0.8rem;">Current levels of storage and supplier integration.</p>
                        </div>

                        <div class="d-flex flex-column gap-3 my-3">
                            <div>
                                <div class="d-flex justify-content-between align-items-center mb-1" style="font-size: 0.85rem; font-weight: 500;">
                                    <span class="text-secondary">Warehouse Storage Utilized</span>
                                    <span class="text-dark">@(availableInventoryCount > 0 ? Math.Min(100, availableInventoryCount / 5).ToString("0") : "0")%</span>
                                </div>
                                <div class="progress rounded-pill bg-light border" style="height: 10px;">
                                    <div class="progress-bar rounded-pill" role="progressbar" style="width: @(availableInventoryCount > 0 ? Math.Min(100, availableInventoryCount / 5).ToString("0") : "0")%; background: var(--primary-gradient) !important;"></div>
                                </div>
                            </div>

                            <div>
                                <div class="d-flex justify-content-between align-items-center mb-1" style="font-size: 0.85rem; font-weight: 500;">
                                    <span class="text-secondary">Procurement Spend Budget</span>
                                    <span class="text-dark">@expenseRatio%</span>
                                </div>
                                <div class="progress rounded-pill bg-light border" style="height: 10px;">
                                    <div class="progress-bar rounded-pill" role="progressbar" style="width: @expenseRatio%; background: linear-gradient(135deg, #0ea5e9 0%, #3b82f6 100%) !important;"></div>
                                </div>
                            </div>

                            <div>
                                <div class="d-flex justify-content-between align-items-center mb-1" style="font-size: 0.85rem; font-weight: 500;">
                                    <span class="text-secondary">Accounts Receivable Liquidation</span>
                                    <span class="text-dark">@(totalRevenue + pendingRevenue > 0 ? (totalRevenue / (totalRevenue + pendingRevenue) * 100).ToString("0.0") : "0")%</span>
                                </div>
                                <div class="progress rounded-pill bg-light border" style="height: 10px;">
                                    <div class="progress-bar rounded-pill bg-success" role="progressbar" style="width: @(totalRevenue + pendingRevenue > 0 ? (totalRevenue / (totalRevenue + pendingRevenue) * 100).ToString("0") : "0")%;"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Recent Activities Summary Grid -->
                <div class="row g-4">
                    <div class="col-lg-6">
                        <div class="db-table-card p-4">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h4 class="m-0 fw-bold text-dark" style="font-size: 1.1rem;">Recent Receivables</h4>
                                <button class="btn btn-sm btn-link text-primary p-0 fw-bold text-decoration-none switch-to-tab" data-target="invoices">View Ledger</button>
                            </div>
                            <div class="table-responsive-custom">
                                <table class="db-user-table m-0">
                                    <thead>
                                        <tr>
                                            <th>Invoice #</th>
                                            <th>Customer</th>
                                            <th>Amount</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (invoices.Any())
                                        {
                                            @foreach (var item in invoices.Take(4))
                                            {
                                                <tr>
                                                    <td class="fw-bold text-dark">@item.InvoiceNumber</td>
                                                    <td>@item.CustomerName</td>
                                                    <td>$@item.Amount.ToString("N2")</td>
                                                    <td>
                                                        <span class="badge-custom @(item.Status == "Paid" ? "badge-paid" : item.Status == "Pending" ? "badge-pending" : "badge-overdue")">
                                                            @item.Status
                                                        </span>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan="4" class="text-center py-4 text-muted">No invoices found.</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-6">
                        <div class="db-table-card p-4">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h4 class="m-0 fw-bold text-dark" style="font-size: 1.1rem;">Key Inventory Warning</h4>
                                <button class="btn btn-sm btn-link text-primary p-0 fw-bold text-decoration-none switch-to-tab" data-target="inventory">Manage Items</button>
                            </div>
                            <div class="table-responsive-custom">
                                <table class="db-user-table m-0">
                                    <thead>
                                        <tr>
                                            <th>SKU</th>
                                            <th>Item Name</th>
                                            <th>In Stock</th>
                                            <th>Level</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (inventory.Any())
                                        {
                                            @foreach (var item in inventory.OrderBy(i => i.Quantity).Take(4))
                                            {
                                                <tr>
                                                    <td class="fw-bold text-dark">@item.SKU</td>
                                                    <td>@item.Name</td>
                                                    <td>@item.Quantity</td>
                                                    <td>
                                                        <span class="badge-custom @(item.Quantity > 50 ? "badge-instock" : item.Quantity > 5 ? "badge-lowstock" : "badge-outstock")">
                                                            @(item.Quantity > 50 ? "Healthy" : item.Quantity > 5 ? "Low Stock" : "Critical")
                                                        </span>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan="4" class="text-center py-4 text-muted">No inventory items.</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Tab: SALES & INVOICES -->
            <section class="erp-tab-content" id="invoices">
                <div class="erp-module-header">
                    <div class="erp-module-title">
                        <h2>Sales & Accounts Receivables</h2>
                        <p>Generate, monitor, and update outgoing customer sales invoices.</p>
                    </div>
                    <button class="erp-btn erp-btn-primary" onclick="openModal('invoiceModal')">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                        <span>Create Invoice</span>
                    </button>
                </div>

                <!-- Filters -->
                <div class="erp-filters">
                    <input type="text" placeholder="Search by customer..." class="erp-filter-input" id="invoiceSearch" style="width: 280px;" />
                    <select class="erp-filter-input" id="invoiceStatusFilter" style="width: 180px;">
                        <option value="">All Statuses</option>
                        <option value="Paid">Paid</option>
                        <option value="Pending">Pending</option>
                        <option value="Overdue">Overdue</option>
                    </select>
                </div>

                <!-- Datagrid Table Card -->
                <div class="db-table-card">
                    <div class="table-responsive-custom">
                        <table class="db-user-table" id="invoicesTable">
                            <thead>
                                <tr>
                                    <th>Invoice Number</th>
                                    <th>Customer Name</th>
                                    <th>Created Date</th>
                                    <th>Description</th>
                                    <th>Amount</th>
                                    <th>Status State</th>
                                    <th class="text-end">Update Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (invoices.Any())
                                {
                                    @foreach (var item in invoices)
                                    {
                                        <tr data-customer="@item.CustomerName.ToLower()" data-status="@item.Status">
                                            <td class="fw-bold text-dark">@item.InvoiceNumber</td>
                                            <td>@item.CustomerName</td>
                                            <td>@item.CreatedDate.ToString("yyyy-MM-dd HH:mm")</td>
                                            <td style="max-width: 220px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@item.Description</td>
                                            <td class="fw-bold text-primary">$@item.Amount.ToString("N2")</td>
                                            <td>
                                                <span class="badge-custom @(item.Status == "Paid" ? "badge-paid" : item.Status == "Pending" ? "badge-pending" : "badge-overdue")">
                                                    @item.Status
                                                </span>
                                            </td>
                                            <td class="text-end">
                                                <select class="form-select form-select-sm d-inline-block update-invoice-status" data-id="@item.Id" style="width: 110px; font-size: 0.8rem; border-radius: 8px;">
                                                    <option value="Paid" selected="@(item.Status == "Paid")">Paid</option>
                                                    <option value="Pending" selected="@(item.Status == "Pending")">Pending</option>
                                                    <option value="Overdue" selected="@(item.Status == "Overdue")">Overdue</option>
                                                </select>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="7" class="text-center py-5 text-muted">No invoices populated in ERP databases.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>

            <!-- Tab: INVENTORY -->
            <section class="erp-tab-content" id="inventory">
                <div class="erp-module-header">
                    <div class="erp-module-title">
                        <h2>Material Assets & Catalog</h2>
                        <p>Track current warehouse stock, items categories, and retail unit valuations.</p>
                    </div>
                    <button class="erp-btn erp-btn-primary" onclick="openAddInventoryModal()">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                        <span>Add Product</span>
                    </button>
                </div>

                <!-- Filters -->
                <div class="erp-filters">
                    <input type="text" placeholder="Search by name or SKU..." class="erp-filter-input" id="inventorySearch" style="width: 280px;" />
                    <select class="erp-filter-input" id="inventoryCategoryFilter" style="width: 180px;">
                        <option value="">All Categories</option>
                        @foreach (var cat in inventory.Select(i => i.Category).Distinct())
                        {
                            <option value="@cat">@cat</option>
                        }
                    </select>
                </div>

                <!-- Catalog Grid -->
                <div class="db-table-card">
                    <div class="table-responsive-custom">
                        <table class="db-user-table" id="inventoryTable">
                            <thead>
                                <tr>
                                    <th>SKU Identifier</th>
                                    <th>Item Catalog Name</th>
                                    <th>Category Group</th>
                                    <th>Quantity in Stock</th>
                                    <th>Unit Valuation</th>
                                    <th>Total Worth</th>
                                    <th>Last Updated</th>
                                    <th class="text-end">Edit Options</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (inventory.Any())
                                {
                                    @foreach (var item in inventory)
                                    {
                                        <tr data-name="@item.Name.ToLower() @item.SKU.ToLower()" data-category="@item.Category">
                                            <td class="fw-bold text-dark">@item.SKU</td>
                                            <td>@item.Name</td>
                                            <td><span class="badge bg-light text-secondary border px-2 py-1 rounded-3">@item.Category</span></td>
                                            <td>
                                                <span class="fw-bold text-dark">@item.Quantity</span>
                                            </td>
                                            <td>$@item.UnitPrice.ToString("N2")</td>
                                            <td class="fw-bold text-primary">$@((item.Quantity * item.UnitPrice).ToString("N2"))</td>
                                            <td style="font-size: 0.82rem;">@item.LastUpdated.ToString("yyyy-MM-dd HH:mm")</td>
                                            <td class="text-end">
                                                <button class="btn btn-sm btn-outline-primary py-1 px-3 edit-inventory-btn" 
                                                        data-id="@item.Id"
                                                        data-sku="@item.SKU"
                                                        data-name="@item.Name"
                                                        data-category="@item.Category"
                                                        data-quantity="@item.Quantity"
                                                        data-price="@item.UnitPrice"
                                                        style="border-radius: 8px; font-weight: 600; font-size: 0.8rem;">
                                                    Edit Details
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="8" class="text-center py-5 text-muted">Warehouse catalog database empty.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>

            <!-- Tab: PURCHASE ORDERS -->
            <section class="erp-tab-content" id="purchaseorders">
                <div class="erp-module-header">
                    <div class="erp-module-title">
                        <h2>Supplier Procurement Ledgers</h2>
                        <p>Purchase assets, raise requisitions, and track active supply pipelines.</p>
                    </div>
                    <button class="erp-btn erp-btn-primary" onclick="openModal('poModal')">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                        <span>Raise PO Requisition</span>
                    </button>
                </div>

                <!-- Datagrid Table -->
                <div class="db-table-card">
                    <div class="table-responsive-custom">
                        <table class="db-user-table">
                            <thead>
                                <tr>
                                    <th>PO Number</th>
                                    <th>Supplier Identity</th>
                                    <th>Materials Requested</th>
                                    <th>Quantity</th>
                                    <th>Unit Cost</th>
                                    <th>Acquisition Cost</th>
                                    <th>Order Date</th>
                                    <th>Fulfillment State</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (purchaseOrders.Any())
                                {
                                    @foreach (var item in purchaseOrders)
                                    {
                                        <tr>
                                            <td class="fw-bold text-dark">@item.PONumber</td>
                                            <td>@item.SupplierName</td>
                                            <td>@item.ItemName</td>
                                            <td>@item.Quantity</td>
                                            <td>$@item.UnitPrice.ToString("N2")</td>
                                            <td class="fw-bold text-primary">$@item.TotalCost.ToString("N2")</td>
                                            <td>@item.OrderDate.ToString("yyyy-MM-dd HH:mm")</td>
                                            <td>
                                                <span class="badge-custom @(item.Status == "Received" ? "badge-received" : item.Status == "Approved" ? "badge-approved" : "badge-pending")">
                                                    @item.Status
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="8" class="text-center py-5 text-muted">No procurement contracts raised.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>

            <!-- Tab: SHOPIFY ORDERS -->
            <section class="erp-tab-content" id="shopify">
                <div class="erp-module-header">
                    <div class="erp-module-title">
                        <h2>Shopify Order Management</h2>
                        <p>Take manual orders, process customer purchases, and track shop fulfillment status.</p>
                    </div>
                    <div class="d-flex gap-2">
                        @if (shopifyOrders.Any())
                        {
                            <button class="erp-btn erp-btn-secondary text-danger border-danger-subtle" onclick="clearAllShopifyOrders()">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2 2v2"></path></svg>
                                <span>Delete All Orders</span>
                            </button>
                        }
                        <button class="erp-btn erp-btn-primary" onclick="openShopifyOrderModal()">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                            <span>Take Shopify Order</span>
                        </button>
                    </div>
                </div>

                <!-- Stats Summary -->
                <div class="stats-widget-grid mb-4" style="grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));">
                    <div class="stat-card">
                        <div class="stat-icon" style="color: #4f46e5; border-color: rgba(79, 70, 229, 0.25); background: linear-gradient(135deg, rgba(79, 70, 229, 0.08) 0%, rgba(67, 56, 202, 0.08) 100%) !important;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                        </div>
                        <div class="stat-data">
                            <span class="stat-num">$@shopifyTotalSales.ToString("N2")</span>
                            <span class="stat-title">Shopify Total Revenue</span>
                        </div>
                    </div>
                    
                    <div class="stat-card">
                        <div class="stat-icon" style="color: #06b6d4; border-color: rgba(6, 182, 212, 0.25); background: linear-gradient(135deg, rgba(6, 182, 212, 0.08) 0%, rgba(8, 145, 178, 0.08) 100%) !important;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/></svg>
                        </div>
                        <div class="stat-data">
                            <span class="stat-num">@shopifyOrderCount orders</span>
                            <span class="stat-title">Total Orders Logged</span>
                        </div>
                    </div>

                    <div class="stat-card">
                        <div class="stat-icon" style="color: #f59e0b; border-color: rgba(245, 158, 11, 0.25); background: linear-gradient(135deg, rgba(245, 158, 11, 0.08) 0%, rgba(217, 119, 6, 0.08) 100%) !important;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
                        </div>
                        <div class="stat-data">
                            <span class="stat-num">@shopifyUnfulfilledCount orders</span>
                            <span class="stat-title">Unfulfilled Queue</span>
                        </div>
                    </div>
                </div>

                <!-- Filters -->
                <div class="erp-filters">
                    <input type="text" placeholder="Search orders by customer or store..." class="erp-filter-input" id="shopifySearch" style="width: 280px;" />
                    <select class="erp-filter-input" id="shopifyFulfillmentFilter" style="width: 180px;">
                        <option value="">All Fulfillments</option>
                        <option value="Fulfilled">Fulfilled</option>
                        <option value="Unfulfilled">Unfulfilled</option>
                    </select>
                    <select class="erp-filter-input" id="shopifyPaymentFilter" style="width: 180px;">
                        <option value="">All Payment States</option>
                        <option value="Paid">Paid</option>
                        <option value="Pending">Pending</option>
                        <option value="Refunded">Refunded</option>
                        <option value="Voided">Voided</option>
                    </select>
                </div>

                <!-- Datagrid Table Card -->
                <div class="db-table-card">
                    <div class="table-responsive-custom">
                        <table class="db-user-table" id="shopifyTable">
                            <thead>
                                <tr>
                                    <th>Order Name</th>
                                    <th>Shopify Store</th>
                                    <th>Customer Legal Name</th>
                                    <th>Created Date</th>
                                    <th>Items Qty</th>
                                    <th>Order Total</th>
                                    <th>Payment Status</th>
                                    <th>Fulfillment Status</th>
                                    <th class="text-end">Status Update</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (shopifyOrders.Any())
                                {
                                    @foreach (var order in shopifyOrders)
                                    {
                                        <tr data-search="@order.CustomerName.ToLower() @order.ShopifyDomain.ToLower() @order.OrderNumber.ToLower()" data-fulfillment="@order.FulfillmentStatus" data-payment="@order.FinancialStatus">
                                            <td class="fw-bold text-dark">
                                                <a href="javascript:void(0);" class="text-decoration-none view-shopify-order" data-id="@order.Id" style="color: var(--primary-color);">
                                                    @order.OrderNumber
                                                </a>
                                            </td>
                                            <td>
                                                <span class="badge bg-light text-secondary border px-2 py-1 rounded-3">@order.ShopifyDomain</span>
                                            </td>
                                            <td>
                                                <div class="d-flex flex-column">
                                                    <span class="fw-semibold text-dark">@order.CustomerName</span>
                                                    <span class="text-muted" style="font-size: 0.75rem;">@order.CustomerEmail</span>
                                                </div>
                                            </td>
                                            <td style="font-size: 0.82rem;">@order.CreatedDate.ToString("yyyy-MM-dd HH:mm")</td>
                                            <td class="fw-semibold text-dark">@order.OrderItems.Sum(oi => oi.Quantity)</td>
                                            <td class="fw-bold text-primary">$@order.TotalAmount.ToString("N2")</td>
                                            <td>
                                                <span class="badge-custom @(order.FinancialStatus == "Paid" ? "badge-paid" : order.FinancialStatus == "Pending" ? "badge-pending" : "badge-overdue")">
                                                    @order.FinancialStatus
                                                </span>
                                            </td>
                                            <td>
                                                <span class="badge-custom @(order.FulfillmentStatus == "Fulfilled" ? "badge-instock" : "badge-outstock")">
                                                    @order.FulfillmentStatus
                                                </span>
                                            </td>
                                            <td class="text-end">
                                                <div class="d-flex justify-content-end gap-1">
                                                    <button class="btn btn-sm btn-outline-primary py-1 px-2 update-shopify-status-btn" 
                                                            data-id="@order.Id"
                                                            data-order="@order.OrderNumber"
                                                            data-domain="@order.ShopifyDomain"
                                                            data-financial="@order.FinancialStatus"
                                                            data-fulfillment="@order.FulfillmentStatus"
                                                            style="border-radius: 8px; font-weight: 600; font-size: 0.78rem;">
                                                        Update Status
                                                    </button>
                                                    <button class="btn btn-sm btn-outline-danger py-1 px-2 delete-shopify-order-btn" 
                                                            data-id="@order.Id"
                                                            data-order="@order.OrderNumber"
                                                            style="border-radius: 8px; font-weight: 600; font-size: 0.78rem;">
                                                        Delete
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="9" class="text-center py-5 text-muted">No Shopify orders logged in ERP database.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>

            <!-- Tab: AUDIT LOGS -->
            <section class="erp-tab-content" id="auditlogs">
                <div class="erp-module-header">
                    <div class="erp-module-title">
                        <h2>System Audit Trails</h2>
                        <p>Complete historical logs of actions made in the console database.</p>
                    </div>
                    <div class="d-flex gap-2">
                        @if (auditLogs.Any(a => a.Username == "Shopify Webhook" || a.Action.Contains("Shopify") || a.Details.Contains("Shopify")))
                        {
                            <button class="erp-btn erp-btn-secondary text-danger border-danger-subtle" onclick="clearShopifyAuditLogs()">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                                <span>Delete Shopify Audits</span>
                            </button>
                        }
                        @if (auditLogs.Any())
                        {
                            <button class="erp-btn erp-btn-secondary text-danger border-danger-subtle" onclick="clearAllAuditLogs()">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                                <span>Delete All Audits</span>
                            </button>
                        }
                    </div>
                </div>

                <div class="db-table-card p-4">
                    <div class="table-responsive-custom" style="max-height: 480px; overflow-y: auto;">
                        <table class="db-user-table">
                            <thead>
                                <tr>
                                    <th>Time Event</th>
                                    <th>User Identity</th>
                                    <th>Action Log</th>
                                    <th>Cryptographic Context Details</th>
                                    <th class="text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (auditLogs.Any())
                                {
                                    @foreach (var log in auditLogs)
                                    {
                                        <tr>
                                            <td class="text-nowrap" style="font-size: 0.85rem; font-family: var(--font-mono); color: var(--text-muted);">@log.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                            <td class="fw-bold text-dark">@log.Username</td>
                                            <td><span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 rounded-3">@log.Action</span></td>
                                            <td style="font-size: 0.85rem;" class="text-secondary">@log.Details</td>
                                            <td class="text-end">
                                                <button class="btn btn-sm btn-outline-danger py-1 px-2 delete-audit-btn" 
                                                        data-id="@log.Id" 
                                                        style="border-radius: 8px; font-weight: 600; font-size: 0.78rem;">
                                                    Delete
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5" class="text-center py-5 text-muted">No trace logs recorded.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>

        </main>
    </div>
</div>

<!-- ============================================== -->
<!-- ERP MODALS SYSTEM -->
<!-- ============================================== -->

<!-- 1. Invoice Modal -->
<div class="erp-modal-overlay" id="invoiceModal">
    <div class="erp-modal-card">
        <div class="erp-modal-header">
            <h3>Create Customer Invoice</h3>
            <button class="erp-modal-close" onclick="closeModal('invoiceModal')">&times;</button>
        </div>
        <form id="createInvoiceForm" class="erp-form">
            @Html.AntiForgeryToken()
            <div class="erp-input-group">
                <label for="invCustomer">Customer Legal Name</label>
                <input type="text" id="invCustomer" name="customerName" placeholder="e.g. Acme Corporation" required class="erp-input" />
            </div>

            <div class="erp-grid-half">
                <div class="erp-input-group">
                    <label for="invAmount">Invoice Value ($)</label>
                    <input type="number" id="invAmount" name="amount" placeholder="0.00" step="0.01" min="0.01" required class="erp-input" />
                </div>
                <div class="erp-input-group">
                    <label for="invStatus">Status State</label>
                    <select id="invStatus" name="status" class="erp-select">
                        <option value="Pending">Pending</option>
                        <option value="Paid">Paid</option>
                        <option value="Overdue">Overdue</option>
                    </select>
                </div>
            </div>

            <div class="erp-input-group">
                <label for="invDesc">Description / Project Details</label>
                <textarea id="invDesc" name="description" placeholder="Specify deliverables or billing items contract..." class="erp-textarea"></textarea>
            </div>

            <div class="erp-modal-actions">
                <button type="button" class="erp-btn erp-btn-secondary" onclick="closeModal('invoiceModal')">Cancel</button>
                <button type="submit" class="erp-btn erp-btn-primary">Generate Invoice</button>
            </div>
        </form>
    </div>
</div>

<!-- 2. Inventory Modal -->
<div class="erp-modal-overlay" id="inventoryModal">
    <div class="erp-modal-card">
        <div class="erp-modal-header">
            <h3 id="inventoryModalTitle">Add Catalog Product</h3>
            <button class="erp-modal-close" onclick="closeModal('inventoryModal')">&times;</button>
        </div>
        <form id="saveInventoryForm" class="erp-form">
            @Html.AntiForgeryToken()
            <input type="hidden" id="inventoryId" name="id" />

            <div class="erp-grid-half">
                <div class="erp-input-group">
                    <label for="invSKU">SKU Barcode</label>
                    <input type="text" id="invSKU" name="sku" placeholder="e.g. SKU-9009" required class="erp-input" />
                </div>
                <div class="erp-input-group">
                    <label for="invCategory">Item Category</label>
                    <input type="text" id="invCategory" name="category" placeholder="e.g. Hardware, Cables" required class="erp-input" />
                </div>
            </div>

            <div class="erp-input-group">
                <label for="invItemName">Catalog Name</label>
                <input type="text" id="invItemName" name="name" placeholder="Item product detail description..." required class="erp-input" />
            </div>

            <div class="erp-grid-half">
                <div class="erp-input-group">
                    <label for="invQuantity">Stock Quantity</label>
                    <input type="number" id="invQuantity" name="quantity" placeholder="0" min="0" required class="erp-input" />
                </div>
                <div class="erp-input-group">
                    <label for="invUnitPrice">Unit Value ($)</label>
                    <input type="number" id="invUnitPrice" name="unitPrice" placeholder="0.00" step="0.01" min="0.01" required class="erp-input" />
                </div>
            </div>

            <div class="erp-modal-actions">
                <button type="button" class="erp-btn erp-btn-secondary" onclick="closeModal('inventoryModal')">Cancel</button>
                <button type="submit" class="erp-btn erp-btn-primary" id="saveInventoryBtn">Save to Catalog</button>
            </div>
        </form>
    </div>
</div>

<!-- 3. Purchase Order Modal -->
<div class="erp-modal-overlay" id="poModal">
    <div class="erp-modal-card">
        <div class="erp-modal-header">
            <h3>Raise Supplier PO</h3>
            <button class="erp-modal-close" onclick="closeModal('poModal')">&times;</button>
        </div>
        <form id="createPOForm" class="erp-form">
            @Html.AntiForgeryToken()
            <div class="erp-input-group">
                <label for="poSupplier">Supplier Company</label>
                <input type="text" id="poSupplier" name="supplierName" placeholder="e.g. Cisco Systems, Intel Corp" required class="erp-input" />
            </div>

            <div class="erp-input-group">
                <label for="poItemName">Material Item Details</label>
                <input type="text" id="poItemName" name="itemName" placeholder="What materials are being procured..." required class="erp-input" />
            </div>

            <div class="erp-grid-half">
                <div class="erp-input-group">
                    <label for="poQuantity">Units Required</label>
