@section Scripts {
    <script>
        // ==============================================
        // TOAST NOTIFICATIONS
        // ==============================================
        function showToast(message, type = 'info') {
            const container = document.getElementById('toastContainer');
            const toast = document.createElement('div');
            toast.className = `custom-toast toast-${type}`;
            
            let icon = '';
            if (type === 'success') {
                icon = '<svg class="toast-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>';
            } else if (type === 'error') {
                icon = '<svg class="toast-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>';
            } else {
                icon = '<svg class="toast-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>';
            }

            toast.innerHTML = `${icon}<span class="toast-message">${message}</span>`;
            container.appendChild(toast);

            setTimeout(() => {
                toast.classList.add('fade-out');
                setTimeout(() => toast.remove(), 400);
            }, 3500);
        }

        // ==============================================
        // TABS NAVIGATION CONTROLS
        // ==============================================
        document.querySelectorAll('.erp-nav-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                const target = btn.getAttribute('data-target');
                
                // Toggle active buttons
                document.querySelectorAll('.erp-nav-btn').forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
                
                // Toggle active panels
                document.querySelectorAll('.erp-tab-content').forEach(panel => panel.classList.remove('active'));
                document.getElementById(target).classList.add('active');

                // Close sidebar on mobile
                const sidebar = document.querySelector('.erp-sidebar');
                if (sidebar) {
                    sidebar.classList.remove('active');
                }
            });
        });

        // Mobile menu toggle
        const menuToggle = document.getElementById('menuToggle');
        if (menuToggle) {
            menuToggle.addEventListener('click', () => {
                const sidebar = document.querySelector('.erp-sidebar');
                if (sidebar) {
                    sidebar.classList.toggle('active');
                }
            });
        }

        // Handle internal quick link redirects
        document.querySelectorAll('.switch-to-tab').forEach(link => {
            link.addEventListener('click', () => {
                const target = link.getAttribute('data-target');
                const sidebarBtn = document.querySelector(`.erp-nav-btn[data-target="${target}"]`);
                if (sidebarBtn) {
                    sidebarBtn.click();
                }
            });
        });

        // ==============================================
        // MODALS SHOW/HIDE SYSTEM
        // ==============================================
        function openModal(modalId) {
            const overlay = document.getElementById(modalId);
            overlay.style.display = 'flex';
            setTimeout(() => overlay.classList.add('active'), 10);
        }

        function closeModal(modalId) {
            const overlay = document.getElementById(modalId);
            overlay.classList.remove('active');
            setTimeout(() => overlay.style.display = 'none', 300);
        }

        function openAddInventoryModal() {
            document.getElementById('inventoryId').value = '';
            document.getElementById('saveInventoryForm').reset();
            document.getElementById('invSKU').removeAttribute('readonly');
            document.getElementById('inventoryModalTitle').innerText = 'Add Catalog Product';
            document.getElementById('saveInventoryBtn').innerText = 'Add Product to Catalog';
            openModal('inventoryModal');
        }

        // ==============================================
        // SEARCH AND FILTERS HANDLERS
        // ==============================================
        // Invoices filter
        const invSearch = document.getElementById('invoiceSearch');
        const invStatusFilter = document.getElementById('invoiceStatusFilter');
        const invTableRows = document.querySelectorAll('#invoicesTable tbody tr');

        function filterInvoices() {
            const searchVal = invSearch.value.toLowerCase();
            const statusVal = invStatusFilter.value;

            invTableRows.forEach(row => {
                const customer = row.getAttribute('data-customer') || '';
                const status = row.getAttribute('data-status') || '';
                
                const matchesSearch = customer.includes(searchVal);
                const matchesStatus = statusVal === '' || status === statusVal;

                if (matchesSearch && matchesStatus) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        }
        if (invSearch) invSearch.addEventListener('input', filterInvoices);
        if (invStatusFilter) invStatusFilter.addEventListener('change', filterInvoices);

        // Inventory filter
        const itemSearch = document.getElementById('inventorySearch');
        const itemCatFilter = document.getElementById('inventoryCategoryFilter');
        const itemTableRows = document.querySelectorAll('#inventoryTable tbody tr');

        function filterInventory() {
            const searchVal = itemSearch.value.toLowerCase();
            const catVal = itemCatFilter.value;

            itemTableRows.forEach(row => {
                const searchKeys = row.getAttribute('data-name') || '';
                const category = row.getAttribute('data-category') || '';

                const matchesSearch = searchKeys.includes(searchVal);
                const matchesCat = catVal === '' || category === catVal;

                if (matchesSearch && matchesCat) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        }
        if (itemSearch) itemSearch.addEventListener('input', filterInventory);
        if (itemCatFilter) itemCatFilter.addEventListener('change', filterInventory);

        // ==============================================
        // AJAX FORMS SUBMISSIONS
        // ==============================================
        
        // 1. Create Invoice Submission
        const invoiceForm = document.getElementById('createInvoiceForm');
        invoiceForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const formData = new FormData(invoiceForm);
            
            try {
                const response = await fetch('@Url.Action("CreateInvoice", "Dashboard")', {
                    method: 'POST',
                    body: new URLSearchParams(formData)
                });
                const data = await response.json();
                
                if (data.success) {
                    showToast(data.message, 'success');
                    closeModal('invoiceModal');
                    setTimeout(() => location.reload(), 1000);
                } else {
                    showToast(data.message, 'error');
                }
            } catch (err) {
                showToast('A database communication error occurred.', 'error');
            }
        });

        // 2. Update Invoice Status Inline
        document.querySelectorAll('.update-invoice-status').forEach(select => {
            select.addEventListener('change', async () => {
                const invoiceId = select.getAttribute('data-id');
                const newStatus = select.value;
                
                const tokenElement = document.querySelector('input[name="__RequestVerificationToken"]');
                const verificationToken = tokenElement ? tokenElement.value : '';

                const params = new URLSearchParams();
                params.append('id', invoiceId);
                params.append('status', newStatus);
                params.append('__RequestVerificationToken', verificationToken);

                try {
                    const response = await fetch('@Url.Action("UpdateInvoiceStatus", "Dashboard")', {
                        method: 'POST',
                        body: params
                    });
                    const data = await response.json();
                    
                    if (data.success) {
                        showToast(data.message, 'success');
                        setTimeout(() => location.reload(), 1000);
                    } else {
                        showToast(data.message, 'error');
                    }
                } catch (err) {
                    showToast('Failed to update invoice status.', 'error');
                }
            });
        });

        // 3. Edit Inventory Populate Modal
        document.querySelectorAll('.edit-inventory-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                document.getElementById('inventoryId').value = btn.getAttribute('data-id');
                document.getElementById('invSKU').value = btn.getAttribute('data-sku');
                document.getElementById('invSKU').setAttribute('readonly', 'true');
                document.getElementById('invCategory').value = btn.getAttribute('data-category');
                document.getElementById('invItemName').value = btn.getAttribute('data-name');
                document.getElementById('invQuantity').value = btn.getAttribute('data-quantity');
                document.getElementById('invUnitPrice').value = btn.getAttribute('data-price');
                
                document.getElementById('inventoryModalTitle').innerText = 'Edit Catalog Product details';
                document.getElementById('saveInventoryBtn').innerText = 'Save Changes';
                
                openModal('inventoryModal');
            });
        });

        // 4. Save/Edit Inventory Submission
        const inventoryForm = document.getElementById('saveInventoryForm');
        inventoryForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const formData = new FormData(inventoryForm);

            try {
                const response = await fetch('@Url.Action("SaveInventoryItem", "Dashboard")', {
                    method: 'POST',
                    body: new URLSearchParams(formData)
                });
                const data = await response.json();

                if (data.success) {
                    showToast(data.message, 'success');
                    closeModal('inventoryModal');
                    setTimeout(() => location.reload(), 1000);
                } else {
                    showToast(data.message, 'error');
                }
            } catch (err) {
                showToast('Failed to update catalogue data.', 'error');
            }
        });

        // 5. Raise PO Requisition Submission
        const poForm = document.getElementById('createPOForm');
        poForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const formData = new FormData(poForm);

            try {
                const response = await fetch('@Url.Action("CreatePurchaseOrder", "Dashboard")', {
                    method: 'POST',
                    body: new URLSearchParams(formData)
                });
                const data = await response.json();

                if (data.success) {
                    showToast(data.message, 'success');
                    closeModal('poModal');
                    setTimeout(() => location.reload(), 1000);
                } else {
                    showToast(data.message, 'error');
                }
            } catch (err) {
                showToast('Failed to commit PO requisition.', 'error');
            }
        });

        // ==============================================
        // SHOPIFY INTEGRATION SCRIPTS
        // ==============================================
        
        // ERP Catalog Items Data mapped from server
        const erpInventoryCatalog = [
            @foreach(var item in inventory) {
                <text>{ id: @item.Id, sku: '@item.SKU', name: '@item.Name', price: @item.UnitPrice, quantity: @item.Quantity },</text>
            }
        ];

        // All Shopify orders details for client-side modal viewing
        const clientShopifyOrders = {
            @foreach(var order in shopifyOrders) {
                <text>
                '@order.Id': {
                    orderNumber: '@order.OrderNumber',
                    domain: '@order.ShopifyDomain',
                    name: '@order.CustomerName',
                    email: '@order.CustomerEmail',
                    phone: '@order.CustomerPhone',
                    address: '@order.ShippingAddress',
                    city: '@order.City',
                    province: '@order.Province',
                    country: '@order.Country',
                    zip: '@order.ZipCode',
                    subtotal: @order.Subtotal,
                    shipping: @order.ShippingCost,
                    tax: @order.TaxCost,
                    total: @order.TotalAmount,
                    financial: '@order.FinancialStatus',
                    fulfillment: '@order.FulfillmentStatus',
                    notes: '@Html.Raw(order.OrderNotes.Replace("'", "\\'"))',
                    date: '@order.CreatedDate.ToString("yyyy-MM-dd HH:mm")',
                    items: [
                        @foreach(var item in order.OrderItems) {
                            <text>{ sku: '@item.SKU', name: '@item.ItemName', qty: @item.Quantity, price: @item.UnitPrice },</text>
                        }
                    ]
                },
                </text>
            }
        };

        // Open Manual Order Modal
        function openShopifyOrderModal() {
            document.getElementById('createShopifyOrderForm').reset();
            document.getElementById('shopifyItemsBody').innerHTML = '';
            
            // Add a first blank row
            addShopifyItemRow();
            
            recalcShopifyOrderTotals();
            openModal('shopifyOrderModal');
        }

        // Add dynamically a new row to Shopify Order Items
        function addShopifyItemRow() {
            const body = document.getElementById('shopifyItemsBody');
            const rowCount = body.children.length;
            const rowId = `soRow_${Date.now()}_${rowCount}`;

            let selectOptions = '<option value="">-- Choose Product --</option>';
            erpInventoryCatalog.forEach(prod => {
                selectOptions += `<option value="${prod.sku}">${prod.sku} - ${prod.name} ($${prod.price.toFixed(2)})</option>`;
            });
            selectOptions += '<option value="custom">-- Custom Product --</option>';

            const tr = document.createElement('tr');
            tr.id = rowId;
            tr.innerHTML = `
                <td>
                    <select class="form-select form-select-sm so-item-select" style="border-radius: 8px;" onchange="handleShopifyItemSelect('${rowId}')">
                        ${selectOptions}
                    </select>
                    <input type="text" class="form-control form-control-sm mt-1 so-custom-name-input d-none" placeholder="Enter Product Name..." />
                </td>
                <td>
                    <input type="text" class="form-control form-control-sm so-sku-input" readonly placeholder="SKU" />
                </td>
                <td>
                    <input type="number" class="form-control form-control-sm so-price-input text-end" readonly placeholder="0.00" step="0.01" min="0.01" oninput="recalcShopifyOrderTotals()" />
                </td>
                <td>
                    <input type="number" class="form-control form-control-sm so-qty-input" value="1" min="1" oninput="recalcShopifyOrderTotals()" />
                </td>
                <td class="text-end fw-semibold text-dark py-3 so-row-total">$0.00</td>
                <td>
                    <button type="button" class="btn btn-sm btn-outline-danger border-0 p-1" onclick="removeShopifyItemRow('${rowId}')" style="line-height: 1;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                    </button>
                </td>
            `;

            body.appendChild(tr);
            recalcShopifyOrderTotals();
        }

        // Remove row
        function removeShopifyItemRow(rowId) {
            const body = document.getElementById('shopifyItemsBody');
            if (body.children.length > 1) {
                const tr = document.getElementById(rowId);
                if (tr) tr.remove();
                recalcShopifyOrderTotals();
            } else {
                showToast('An order must contain at least 1 item.', 'info');
            }
        }

        // Handle item selection dropdown
        function handleShopifyItemSelect(rowId) {
            const tr = document.getElementById(rowId);
            if (!tr) return;

            const select = tr.querySelector('.so-item-select');
            const customNameInput = tr.querySelector('.so-custom-name-input');
            const skuInput = tr.querySelector('.so-sku-input');
            const priceInput = tr.querySelector('.so-price-input');
            const qtyInput = tr.querySelector('.so-qty-input');

            const val = select.value;

            if (val === 'custom') {
                customNameInput.classList.remove('d-none');
                customNameInput.required = true;
                skuInput.readOnly = false;
                skuInput.value = '';
                priceInput.readOnly = false;
                priceInput.value = '';
            } else if (val === '') {
                customNameInput.classList.add('d-none');
                customNameInput.required = false;
                skuInput.readOnly = true;
                skuInput.value = '';
                priceInput.readOnly = true;
                priceInput.value = '';
            } else {
                customNameInput.classList.add('d-none');
                customNameInput.required = false;
                
                const product = erpInventoryCatalog.find(p => p.sku === val);
                if (product) {
                    skuInput.readOnly = true;
                    skuInput.value = product.sku;
                    priceInput.readOnly = true;
                    priceInput.value = product.price.toFixed(2);
                }
            }
            recalcShopifyOrderTotals();
        }

        // Recalculate Shopify totals
        function recalcShopifyOrderTotals() {
            let subtotal = 0;
            const rows = document.querySelectorAll('#shopifyItemsBody tr');

            rows.forEach(row => {
                const select = row.querySelector('.so-item-select');
                const priceInput = row.querySelector('.so-price-input');
                const qtyInput = row.querySelector('.so-qty-input');
                const rowTotalLabel = row.querySelector('.so-row-total');

                const price = parseFloat(priceInput.value) || 0;
                const qty = parseInt(qtyInput.value) || 0;
                const rowTotal = price * qty;
                subtotal += rowTotal;

                rowTotalLabel.innerText = `$${rowTotal.toFixed(2)}`;
            });

            const shipping = parseFloat(document.getElementById('soShippingInput').value) || 0;
            const tax = subtotal * 0.08; // 8% Tax rate
            const total = subtotal + shipping + tax;

            document.getElementById('soSubtotalLabel').innerText = `$${subtotal.toFixed(2)}`;
            document.getElementById('soSubtotalInput').value = subtotal.toFixed(2);

            document.getElementById('soTaxLabel').innerText = `$${tax.toFixed(2)}`;
            document.getElementById('soTaxInput').value = tax.toFixed(2);

            document.getElementById('soTotalLabel').innerText = `$${total.toFixed(2)}`;
            document.getElementById('soTotalInput').value = total.toFixed(2);
        }

        // Submit Shopify Order form via AJAX
        const createShopifyOrderForm = document.getElementById('createShopifyOrderForm');
        createShopifyOrderForm.addEventListener('submit', async (e) => {
            e.preventDefault();

            // Validate all line items
            const items = [];
            const rows = document.querySelectorAll('#shopifyItemsBody tr');
            let hasError = false;

            rows.forEach(row => {
                const select = row.querySelector('.so-item-select');
                const customNameInput = row.querySelector('.so-custom-name-input');
                const skuInput = row.querySelector('.so-sku-input');
                const priceInput = row.querySelector('.so-price-input');
                const qtyInput = row.querySelector('.so-qty-input');

                let itemName = '';
                if (select.value === 'custom') {
                    itemName = customNameInput.value.trim();
                } else if (select.value !== '') {
                    const prod = erpInventoryCatalog.find(p => p.sku === select.value);
                    itemName = prod ? prod.name : '';
                }

                const sku = skuInput.value.trim();
                const price = parseFloat(priceInput.value) || 0;
                const qty = parseInt(qtyInput.value) || 0;

                if (!sku || !itemName || price <= 0 || qty <= 0) {
                    hasError = true;
                    return;
                }

                items.push({
                    sku: sku,
                    itemName: itemName,
                    quantity: qty,
                    unitPrice: price
                });
            });

            if (hasError || items.length === 0) {
                showToast('Please specify valid product, SKU, quantity and price for all items.', 'error');
                return;
            }

            document.getElementById('itemsJsonInput').value = JSON.stringify(items);

            const formData = new FormData(createShopifyOrderForm);

            try {
                const response = await fetch('@Url.Action("CreateShopifyOrder", "Dashboard")', {
                    method: 'POST',
                    body: new URLSearchParams(formData)
                });
                const data = await response.json();

                if (data.success) {
                    showToast(data.message, 'success');
                    closeModal('shopifyOrderModal');
                    setTimeout(() => location.reload(), 1000);
                } else {
                    showToast(data.message, 'error');
                }
            } catch (err) {
                showToast('A database communication error occurred.', 'error');
            }
        });

        // Open Shopify Status update modal
        document.querySelectorAll('.update-shopify-status-btn').forEach(btn => {
            btn.addEventListener('click', (e) => {
                e.stopPropagation(); // Avoid triggering row clicks
                const id = btn.getAttribute('data-id');
                const order = btn.getAttribute('data-order');
                const domain = btn.getAttribute('data-domain');
                const financial = btn.getAttribute('data-financial');
                const fulfillment = btn.getAttribute('data-fulfillment');

                document.getElementById('statusOrderId').value = id;
                document.getElementById('statusOrderNameLabel').innerText = order;
                document.getElementById('statusOrderDomainLabel').innerText = domain;
                document.getElementById('statusFinancial').value = financial;
                document.getElementById('statusFulfillment').value = fulfillment;

                openModal('shopifyStatusModal');
            });
        });

        // Submit Status Update
        const updateShopifyStatusForm = document.getElementById('updateShopifyStatusForm');
        updateShopifyStatusForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const formData = new FormData(updateShopifyStatusForm);

            try {
                const response = await fetch('@Url.Action("UpdateShopifyOrderStatus", "Dashboard")', {
                    method: 'POST',
                    body: new URLSearchParams(formData)
                });
                const data = await response.json();

                if (data.success) {
                    showToast(data.message, 'success');
                    closeModal('shopifyStatusModal');
                    setTimeout(() => location.reload(), 1000);
                } else {
                    showToast(data.message, 'error');
                }
            } catch (err) {
                showToast('Failed to update Shopify Order status.', 'error');
            }
        });

        // Delete individual Shopify order
        document.querySelectorAll('.delete-shopify-order-btn').forEach(btn => {
            btn.addEventListener('click', async (e) => {
                e.stopPropagation();
                const id = btn.getAttribute('data-id');
                const orderNum = btn.getAttribute('data-order');
                if (!confirm(`Are you sure you want to delete Shopify Order ${orderNum}?`)) return;

                try {
                    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                    const response = await fetch('@Url.Action("DeleteShopifyOrder", "Dashboard")', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                        },
                        body: new URLSearchParams({ id: id, __RequestVerificationToken: token || '' })
                    });
                    const data = await response.json();

                    if (data.success) {
                        showToast(data.message, 'success');
                        setTimeout(() => location.reload(), 1000);
                    } else {
                        showToast(data.message, 'error');
                    }
                } catch (err) {
                    showToast('Failed to delete Shopify Order.', 'error');
                }
            });
        });

        // Clear all Shopify orders
        window.clearAllShopifyOrders = async function() {
            if (!confirm('Are you sure you want to delete ALL Shopify orders? This action cannot be undone.')) return;

            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                const response = await fetch('@Url.Action("ClearAllShopifyOrders", "Dashboard")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                    },
                    body: new URLSearchParams({ __RequestVerificationToken: token || '' })
                });
                const data = await response.json();

                if (data.success) {
                    showToast(data.message, 'success');
                    setTimeout(() => location.reload(), 1000);
                } else {
                    showToast(data.message, 'error');
                }
            } catch (err) {
                showToast('Failed to clear Shopify Orders.', 'error');
            }
        };

        // Delete single Audit Log
        document.querySelectorAll('.delete-audit-btn').forEach(btn => {
            btn.addEventListener('click', async (e) => {
                e.stopPropagation();
                const id = btn.getAttribute('data-id');
                if (!confirm('Are you sure you want to delete this audit log entry?')) return;

                try {
                    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                    const response = await fetch('@Url.Action("DeleteAuditLog", "Dashboard")', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                        },
                        body: new URLSearchParams({ id: id, __RequestVerificationToken: token || '' })
                    });
                    const data = await response.json();

                    if (data.success) {
                        showToast(data.message, 'success');
                        setTimeout(() => location.reload(), 1000);
                    } else {
                        showToast(data.message, 'error');
                    }
                } catch (err) {
                    showToast('Failed to delete audit log entry.', 'error');
                }
            });
        });

        // Clear Shopify Audit Logs
        window.clearShopifyAuditLogs = async function() {
            if (!confirm('Are you sure you want to delete all Shopify-related audit logs?')) return;

            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                const response = await fetch('@Url.Action("ClearShopifyAuditLogs", "Dashboard")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                    },
                    body: new URLSearchParams({ __RequestVerificationToken: token || '' })
                });
                const data = await response.json();

                if (data.success) {
                    showToast(data.message, 'success');
                    setTimeout(() => location.reload(), 1000);
                } else {
                    showToast(data.message, 'error');
                }
            } catch (err) {
                showToast('Failed to clear Shopify audit logs.', 'error');
            }
        };

        // Clear All Audit Logs
        window.clearAllAuditLogs = async function() {
            if (!confirm('Are you sure you want to delete ALL system audit logs? This action cannot be undone.')) return;

            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                const response = await fetch('@Url.Action("ClearAllAuditLogs", "Dashboard")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                    },
                    body: new URLSearchParams({ __RequestVerificationToken: token || '' })
                });
                const data = await response.json();

                if (data.success) {
                    showToast(data.message, 'success');
                    setTimeout(() => location.reload(), 1000);
                } else {
                    showToast(data.message, 'error');
                }
            } catch (err) {
                showToast('Failed to clear audit logs.', 'error');
            }
        };

        // Details Modal View loading
        document.querySelectorAll('.view-shopify-order').forEach(link => {
            link.addEventListener('click', () => {
                const id = link.getAttribute('data-id');
                const order = clientShopifyOrders[id];
                if (!order) return;

                document.getElementById('detailOrderNumber').innerText = order.orderNumber;
                document.getElementById('detailShopifyDomain').innerText = order.domain;
                document.getElementById('detailCreatedDate').innerText = order.date;
                document.getElementById('detailCustomerName').innerText = order.name;
                document.getElementById('detailCustomerEmail').innerText = order.email;
                document.getElementById('detailCustomerPhone').innerText = order.phone || 'N/A';
                document.getElementById('detailShippingAddress').innerText = order.address;
                document.getElementById('detailShippingCityState').innerText = `${order.city}, ${order.province}, ${order.country}`;
                document.getElementById('detailShippingZip').innerText = order.zip;

                // Badges
                const finBadge = document.getElementById('detailFinancialBadge');
                finBadge.innerText = order.financial;
                finBadge.className = 'badge-custom ' + (order.financial === 'Paid' ? 'badge-paid' : order.financial === 'Pending' ? 'badge-pending' : 'badge-overdue');

                const fulBadge = document.getElementById('detailFulfillmentBadge');
                fulBadge.innerText = order.fulfillment;
                fulBadge.className = 'badge-custom ' + (order.fulfillment === 'Fulfilled' ? 'badge-instock' : 'badge-outstock');

                // Items
                const body = document.getElementById('detailItemsBody');
                body.innerHTML = '';
                order.items.forEach(item => {
                    const tr = document.createElement('tr');
                    tr.innerHTML = `
                        <td class="fw-semibold text-dark">${item.sku}</td>
                        <td>${item.name}</td>
                        <td>$${item.price.toFixed(2)}</td>
                        <td>${item.qty}</td>
                        <td class="text-end fw-semibold text-primary">$${(item.qty * item.price).toFixed(2)}</td>
                    `;
                    body.appendChild(tr);
                });

                // Notes & Totals
                document.getElementById('detailOrderNotes').innerText = order.notes || 'No customer notes.';
                document.getElementById('detailSubtotal').innerText = `$${order.subtotal.toFixed(2)}`;
                document.getElementById('detailShipping').innerText = `$${order.shipping.toFixed(2)}`;
                document.getElementById('detailTax').innerText = `$${order.tax.toFixed(2)}`;
                document.getElementById('detailTotal').innerText = `$${order.total.toFixed(2)}`;

                openModal('shopifyOrderDetailModal');
            });
        });

        // Search & Filters for Shopify table
        const shSearch = document.getElementById('shopifySearch');
        const shFulfillFilter = document.getElementById('shopifyFulfillmentFilter');
        const shPayFilter = document.getElementById('shopifyPaymentFilter');
        const shTableRows = document.querySelectorAll('#shopifyTable tbody tr');

        function filterShopifyOrders() {
            const query = shSearch.value.toLowerCase();
            const fulfillVal = shFulfillFilter.value;
            const payVal = shPayFilter.value;

            shTableRows.forEach(row => {
                const searchTxt = row.getAttribute('data-search') || '';
                const fulfillTxt = row.getAttribute('data-fulfillment') || '';
                const payTxt = row.getAttribute('data-payment') || '';

                const matchesSearch = searchTxt.includes(query);
                const matchesFulfill = fulfillVal === '' || fulfillTxt === fulfillVal;
                const matchesPay = payVal === '' || payTxt === payVal;

                if (matchesSearch && matchesFulfill && matchesPay) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        }

        if (shSearch) shSearch.addEventListener('input', filterShopifyOrders);
        if (shFulfillFilter) shFulfillFilter.addEventListener('change', filterShopifyOrders);
        if (shPayFilter) shPayFilter.addEventListener('change', filterShopifyOrders);
    </script>
}
