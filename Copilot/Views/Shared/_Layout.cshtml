<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Copilot</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Copilot.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark custom-navbar">
            <div class="container-fluid px-4">
                <a class="navbar-brand d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="me-2" style="color: #818cf8;"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
                    <span class="brand-text">Copilot ERP</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                    </ul>
                    <ul class="navbar-nav align-items-center gap-2">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item d-flex align-items-center">
                                <span class="nav-user-greeting me-2">Hello, <strong class="text-white">@User.Identity.Name</strong>!</span>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Auth" asp-action="Logout" method="post" class="m-0">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-nav-logout">Sign Out</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-sm btn-nav-login" asp-area="" asp-controller="Auth" asp-action="Index">Sign In / Sign Up</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Copilot - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <!-- FLOATING AI CHATBOT WIDGET & INLINE CONTROLLER -->
    <script>
        function toggleChatbot() {
            var win = document.getElementById('chatbotWindow');
            var input = document.getElementById('chatbotInput');
            if (!win) return;
            
            if (win.style.display === 'flex' || win.classList.contains('active')) {
                win.style.display = 'none';
                win.classList.remove('active');
            } else {
                win.style.display = 'flex';
                win.style.opacity = '1';
                win.style.visibility = 'visible';
                win.classList.add('active');
                if (input) input.focus();
            }
        }

        function appendChatMessage(sender, text, quickActions) {
            var chatBodyEl = document.getElementById('chatbotBody');
            if (!chatBodyEl) return;

            var msgDiv = document.createElement('div');
            msgDiv.className = 'chat-msg ' + sender;

            var formattedText = text
                .replace(/\n\n/g, '</p><p>')
                .replace(/\n/g, '<br>')
                .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
                .replace(/\*(.*?)\*/g, '<em>$1</em>')
                .replace(/`(.*?)`/g, '<code>$1</code>');

            var html = '<div class="msg-bubble"><p>' + formattedText + '</p>';
            if (quickActions && quickActions.length > 0) {
                html += '<div class="chat-quick-actions">';
                quickActions.forEach(function(action) {
                    html += '<button class="btn-quick-action" onclick="switchNavTab(\'' + action.targetTab + '\')">' + action.label + '</button>';
                });
                html += '</div>';
            }
            html += '</div>';

            msgDiv.innerHTML = html;
            chatBodyEl.appendChild(msgDiv);
            chatBodyEl.scrollTop = chatBodyEl.scrollHeight;
        }

        function showTypingIndicator() {
            var chatBodyEl = document.getElementById('chatbotBody');
            if (!chatBodyEl) return;

            var typingDiv = document.createElement('div');
            typingDiv.className = 'chat-msg bot';
            typingDiv.id = 'chatTypingIndicator';
            typingDiv.innerHTML = '<div class="msg-bubble"><div class="typing-indicator"><div class="typing-dot"></div><div class="typing-dot"></div><div class="typing-dot"></div></div></div>';
            chatBodyEl.appendChild(typingDiv);
            chatBodyEl.scrollTop = chatBodyEl.scrollHeight;
        }

        function removeTypingIndicator() {
            var typing = document.getElementById('chatTypingIndicator');
            if (typing) typing.remove();
        }

        async function handleChatSubmit() {
            var inputEl = document.getElementById('chatbotInput');
            if (!inputEl) return;
            var query = inputEl.value.trim();
            if (!query) return;

            appendChatMessage('user', query);
            inputEl.value = '';
            showTypingIndicator();

            try {
                var response = await fetch('/api/chatbot/query', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ message: query })
                });

                var result = await response.json();
                removeTypingIndicator();

                if (result.success && result.data) {
                    appendChatMessage('bot', result.data.answer, result.data.quickActions);
                } else {
                    appendChatMessage('bot', '⚠️ Sorry, I encountered an issue processing your query. Please try again.');
                }
            } catch (err) {
                removeTypingIndicator();
                appendChatMessage('bot', '⚠️ Connection error. Please check your network and try again.');
            }
        }

        function sendChatPrompt(promptText) {
            var inputEl = document.getElementById('chatbotInput');
            if (inputEl) {
                inputEl.value = promptText;
                handleChatSubmit();
            }
        }
    </script>

    <button type="button" class="chatbot-trigger-btn" id="chatbotTriggerBtn" onclick="toggleChatbot()" title="Ask Copilot AI Assistant" style="z-index: 999999 !important;">
        <div class="chatbot-pulse-ring" style="pointer-events: none;"></div>
        <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="pointer-events: none;"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path><path d="M8 9h8"></path><path d="M8 13h6"></path></svg>
    </button>

    <div class="chatbot-window" id="chatbotWindow" style="display: none; flex-direction: column; z-index: 999999 !important;">
        <div class="chatbot-header">
            <div class="d-flex align-items-center gap-2">
                <div class="chatbot-avatar">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><path d="M12 8v4l3 3"></path></svg>
                </div>
                <div>
                    <div class="fw-bold text-white" style="font-size: 0.95rem;">Copilot AI Assistant</div>
                    <div class="d-flex align-items-center gap-1 text-success" style="font-size: 0.72rem;">
                        <span style="width:6px; height:6px; background:#10b981; border-radius:50%; display:inline-block;"></span> NLP Engine Active
                    </div>
                </div>
            </div>
            <button type="button" class="btn-close btn-close-white" onclick="toggleChatbot()" aria-label="Close"></button>
        </div>

        <div class="chatbot-body" id="chatbotBody">
            <div class="chat-msg bot">
                <div class="msg-bubble">
                    <p>👋 Hi! I am your <strong>Copilot ERP Assistant</strong>. Ask me anything about revenue, Shopify orders, low stock, or invoices!</p>
                    <div class="chat-quick-actions">
                        <button class="btn-quick-action" onclick="sendChatPrompt('What is total revenue?')">📊 Total Revenue</button>
                        <button class="btn-quick-action" onclick="sendChatPrompt('Show me recent Shopify orders')">🛒 Shopify Orders</button>
                        <button class="btn-quick-action" onclick="sendChatPrompt('Check low stock items')">⚠️ Low Stock</button>
                        <button class="btn-quick-action" onclick="sendChatPrompt('List pending invoices')">📑 Overdue Invoices</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="chatbot-footer">
            <input type="text" id="chatbotInput" class="chatbot-input" placeholder="Ask AI about orders, inventory, sales..." autocomplete="off" onkeypress="if(event.key==='Enter') handleChatSubmit()" />
            <button type="button" class="chatbot-send-btn" id="chatbotSendBtn" onclick="handleChatSubmit()">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="pointer-events: none;"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
            </button>
        </div>
    </div>
</body>
</html>
